# 保利威密钥（仅后端使用，禁止提交到 git）
POLYV_APP_ID=
POLYV_APP_SECRET=
POLYV_USER_ID=
POLYV_CHANNEL_ID=
POLYV_API_BASE=https://api.polyv.net

# DeepSeek（用于 AI 决策解释 + 复盘报告；留空则走模板兜底）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端口
PORT=4000

# 是否调用真实 Polyv OpenAPI（false=走模拟器，安全演示；true=真实发起互动）
USE_REAL_POLYV=false

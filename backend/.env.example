# ===== 保利威密钥（仅后端使用，禁止提交到 git）=====
# 演示默认走模拟器，可全部留空；接真实账号时再填
POLYV_APP_ID=
POLYV_APP_SECRET=
POLYV_USER_ID=
POLYV_CHANNEL_ID=
POLYV_API_BASE=https://api.polyv.net
# 统计轮询接口路径（官方 v3 get-session-stats）
POLYV_STATS_PATH=/live/v3/channel/statistics/get-session-stats
POLYV_TIMEOUT_MS=6000

# 账号侧资源 ID（真实调用必填；模型/AI 不得生成）
# 商品 ID：推送商品弹层
POLYV_DEFAULT_PRODUCT_ID=
# 优惠券 ID，多个用英文逗号分隔（1~30 个）
POLYV_DEFAULT_COUPON_IDS=
# 卡片 ID：推送卡片
POLYV_DEFAULT_CARD_PUSH_ID=
# 题目 ID：答题卡
POLYV_DEFAULT_QUESTION_ID=

# ===== DeepSeek（AI 决策解释 + 复盘；留空则引擎走模板兜底）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 服务 =====
PORT=4000

# 是否真实调用保利威 OpenAPI
# false（默认）= 模拟执行，彩排绝不污染真实频道
# true          = 真实打频道，需上面 appId/appSecret/channelId 齐备，缺任一项自动降级为模拟
USE_REAL_POLYV=false

# ===== 模拟器（演示节奏）=====
# 单场计划时长（分钟）
SIM_TOTAL_MIN=30
# 加速倍数：1 秒真实时间 = N 秒直播时间（10 → 30 分钟直播约 3 分钟跑完）
SIM_SPEED=10
# tick 间隔（毫秒）
SIM_TICK_MS=800
# 随机种子：固定后每次演示曲线完全一致
SIM_SEED=20261024
